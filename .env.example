TARGET_URL=https://example.com
MODE=rps
RATE=100
DURATION=3m
TIME_UNIT=1s
PRE_ALLOCATED_VUS=80
MAX_VUS=250
VUS=10
RAMP_UP=1m
HOLD=3m
RAMP_DOWN=1m
SLEEP=1
PATHS=/

# Optional public-proxy mode. Never use public proxies for authenticated or sensitive traffic.
USE_PROXY=false
PROXY_PROVIDERS_FILE=proxy-providers.json
PROXY_CACHE_MINUTES=60
MAX_PROXY_CANDIDATES=30
MAX_WORKING_PROXIES=5
PROXY_TEST_CONCURRENCY=10
# Defaults to TARGET_URL when empty.
PROXY_TEST_URL=
